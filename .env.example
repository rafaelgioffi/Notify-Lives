# Banco local. No Debian, substitua pela URL PostgreSQL do container.
DATABASE_URL=sqlite:///./data/notify_lives.db

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp assistido
WHATSAPP_INITIAL_DELAY=2
WHATSAPP_RETRY_DELAY=6
WHATSAPP_MAX_RETRIES=2
WHATSAPP_MANUAL_CONFIRMATION=true

# Serão adicionadas na próxima etapa: Meta Graph API e TikTok Content Posting API.

